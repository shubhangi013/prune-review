{
  "name": "prune-review-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action wrapper for prune-review.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build src/action.ts -o dist --license licenses.txt",
    "bundle": "pnpm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@actions/core": "^1.11.0",
    "@actions/github": "^6.0.0",
    "prune-review": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.6.0"
  }
}
